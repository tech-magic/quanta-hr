{
  "model": {
    "name": "ABC-QLoRA-HR-Assistant",
    "base_llm_model": "TinyLlama/TinyLlama-1.1B-intermediate-step-1431k-3T",
    "quantization": {
      "load_in_4bit": true,
      "bnb_4bit_compute_dtype": "float16",
      "bnb_4bit_use_double_quant": true,
      "bnb_4bit_quant_type": "nf4"
    },
    "lora": {
      "r": 16,
      "lora_alpha": 32,
      "target_modules": ["q_proj", "v_proj"],
      "lora_dropout": 0.05,
      "bias": "none",
      "task_type": "CAUSAL_LM"
    },
    "max_sequence_length": 1024
  },
  "datasets": [
    {
      "id": "hr_policies",
      "type": "docx",
      "input_files": [
        "data/hr_policies/*.docx"
      ],
      "section_detection": {
        "heading_patterns": [
          "^(Section)\\b",
          "^(Policy)\\b",
          "^(Purpose)\\b",
          "^(Scope)\\b",
          "^(Procedure)\\b"
        ],
        "detect_all_caps": true
      },
      "use_cases": {
        "qlora": {
          "alpaca_generator": {
            "provider": "aws",
            "config": {
              "aws_profile": "default",
              "llm_config": {
                "model_id": "anthropic.claude-3-haiku-20240307-v1:0"
              }
            }
          }
        },
        "rag": {
          "sentence_transformer": "all-mpnet-base-v2"
        }
      },
      "max_sequence_length": 300
    },
    {
      "id": "general_knowledge",
      "type": "alpaca",
      "input_files": [
        "data/general_knowledge/*.json"
      ],
      "include_prompt_inputs": true
    }
  ],
  "training": {
    "per_device_train_batch_size": 4,
    "gradient_accumulation_steps": 4,
    "warmup_steps": 50,
    "max_steps": 1000,
    "learning_rate": 0.0002,
    "fp16": true,
    "logging_steps": 10,
    "save_strategy": "steps",
    "save_steps": 50,
    "save_total_limit": 5,
    "report_to": "none",
    "resume_from_uploads": true
  },
  "compute": {
    "platform": "aws",
    "aws_profile": "default",
    "instance_type": "g5.xlarge",
    "boot_os_query": "Deep Learning AMI GPU PyTorch*Ubuntu 20.04*"
  }
}
